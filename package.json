{
  "name": "tarotagent",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint --vue-plugin .",
    "lint:fix": "oxlint --vue-plugin --fix .",
    "lint:ox": "oxlint --vue-plugin .",
    "lint:ox:fix": "oxlint --vue-plugin --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest",
    "test:browser": "bun run test:cairntrace",
    "test:cairntrace": "cairn run tests/cairn --config cairntrace.config.yml --env local --cold-start",
    "test:cairntrace:verify": "cairn spec verify tests/cairn/reading.yml --config cairntrace.config.yml --env local --json && cairn spec verify tests/cairn/saved-reading.yml --config cairntrace.config.yml --env local --json",
    "story:dev": "CHOKIDAR_USEPOLLING=1 HISTOIRE=1 histoire dev",
    "story:build": "CHOKIDAR_USEPOLLING=1 HISTOIRE=1 histoire build",
    "story:preview": "histoire preview",
    "typecheck": "node scripts/typecheck.mjs",
    "migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@nuxt/ui": "4.10.0",
    "@vercel/analytics": "2.0.1",
    "ai": "7.0.55",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "h3": "1.15.11",
    "nuxt": "4.5.2",
    "resend": "6.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@histoire/plugin-vue": "1.0.0-beta.1",
    "@tailwindcss/vite": "4.3.3",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "6.0.8",
    "drizzle-kit": "0.31.10",
    "histoire": "1.0.0-beta.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
