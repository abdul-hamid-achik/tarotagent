# --- Required ---
# Anthropic API key (for Claude — the actual reading interpretations).
# Set this in Vercel before the production deployment, then redeploy if you change it.
ANTHROPIC_API_KEY=

# --- Required for production ---
# Postgres connection string. Production requests fail without this; tests use
# isolated in-memory storage only in TAROT_AGENT_TEST_MODE.
# Get from https://console.neon.tech (use the pooled connection string).
# On Vercel, the build runs `bun run migrate` automatically — schema syncs on every deploy.
# For local dev, run `bun run migrate` once after setting this.
# If you add this after an initial Vercel deploy, redeploy so migrations run.
DATABASE_URL=

# Public site URL (used for share links and Open Graph metadata).
SITE_URL=https://tarotagent.app
SITE_NAME=Tarot Agent

# --- Required for production rate limiting ---
# Vercel Marketplace Redis / Upstash Redis REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Required for archive restore; also enables "email this reading" ---
# When unset, reading-email UI is hidden and restore-code emails cannot be sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tarot Agent <no-reply@yourdomain.com>
